    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst raw =\n  item.output ||                                              // AI Agent output\n  item.content?.parts?.[0]?.text ||                          // direct candidate object (your current shape)\n  item.candidates?.[0]?.content?.parts?.[0]?.text ||          // candidates-wrapped shape\n  item.text ||\n  '';\n\nconst cleaned = raw.replace(/```json|```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    classification: 'Needs Manual Review',\n    confidence: 0,\n    reasoning: 'AI response could not be parsed',\n    suggested_reply: ''\n  };\n}\n\nreturn {\n  json: {\n    ...$('Extract Email Details').item.json,\n    ...parsed\n  }\n};"
      },
