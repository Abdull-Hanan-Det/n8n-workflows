        "gmailOAuth2": {
          "id": "9d4fRrqR73AEf3ch",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=A customer sent the following support email.\n\nFrom: {{ $json.from.text }}\nSubject: {{ $json.subject }}\n\nMessage:\n{{ $json.text }}\n\nWrite a helpful, professional reply to the customer.",
        "options": {
          "systemMessage": "You are a friendly and professional customer support agent. Write clear, empathetic email replies that directly address the customer's question. Be concise. If you do not have enough information to fully resolve the issue (for example order-specific details), acknowledge the request, reassure the customer, and let them know the team is looking into it. Sign off as \"The Support Team\". Output only the body text of the reply email, with no subject line and no placeholders in brackets."
        }
      },
      "id": "fd8ccecc-7899-488e-a9fc-699a63f3ccf8",
      "name": "Draft Support Reply",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        224,
        112
      ]
    },
    {
      "parameters": {
        "model": "llama-3.3-70b-versatile",
        "options": {
          "temperature": 0.4
        }
      },
      "id": "09d5a2b9-487d-47e2-9c52-19e993e25b63",
      "name": "Groq Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        304,
        336
      ],
      "credentials": {
        "groqApi": {
          "id": "L5W8ICm352jwOlxH",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
